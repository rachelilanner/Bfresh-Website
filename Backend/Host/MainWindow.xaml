<Window x:Class="Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Host"
        mc:Ignorable="d"
        Title="MainWindow"  Height="450" Width="800">
    <Grid>
        <TextBlock Text="My Server" FontFamily="Segoe Print" FontWeight="Bold" FontSize="150" >
            <TextBlock.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FFE41B1B" Offset="1"/>
                    <GradientStop Color="#FF5F6EF1" Offset="0.315"/>
                    <GradientStop Color="#FF4DCCD9" Offset="1"/>
                    <GradientStop Color="#FF4DCCD9" Offset="0.016"/>
                </LinearGradientBrush>
            </TextBlock.Background></TextBlock>
    </Grid>
</Window>
