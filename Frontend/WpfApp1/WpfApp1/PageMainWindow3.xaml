<Page x:Class="WpfApp1.PageMainWindow3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:HamburgerMenu="clr-namespace:HamburgerMenu;assembly=HamburgerMenu"
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageMainWindow3">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>


        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"></ColumnDefinition>
            <ColumnDefinition Width="*" ></ColumnDefinition>
           
            
        </Grid.ColumnDefinitions>
        <Frame x:Name="frm2"  Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Grid.ColumnSpan="4"  Source="PageManager.xaml" ></Frame>
        
        <HamburgerMenu:HamburgerMenu Grid.Row="0" HorizontalAlignment="Left" Grid.RowSpan="3" x:Name="hamburger" Grid.Column="0" Background="Gray" MenuItemForeground="Black" >
            <HamburgerMenu:HamburgerMenuItem  x:Name="Empty" Selected="Empty_Selected" SelectionIndicatorColor="Gray" ></HamburgerMenu:HamburgerMenuItem>
          
            <HamburgerMenu:HamburgerMenuItem SelectionIndicatorColor="#FFF70606" Icon="\Images\cup_only.png" x:Name="Drinks" Text="Drinks" Selected="Drinks_Selected" >
                
            </HamburgerMenu:HamburgerMenuItem>


            <HamburgerMenu:HamburgerMenuItem SelectionIndicatorColor="#FFF70606" x:Name="Category" Text="Categories" Icon="\Images\yogurt-removebg-preview.png" Selected="Category_Selected" >
               
            </HamburgerMenu:HamburgerMenuItem>

        
            <HamburgerMenu:HamburgerMenuItem Icon="\Images\toppings-removebg-preview.png" SelectionIndicatorColor="#FFF70606" x:Name="Toppings" Text="Toppings" Selected="Toppings_Selected" >
                
            </HamburgerMenu:HamburgerMenuItem>


            <HamburgerMenu:HamburgerMenuItem Icon="\Images\home icon.png" SelectionIndicatorColor="#FFF70606" x:Name="Home" Text="Home" Selected="Home_Selected"  >
                
            </HamburgerMenu:HamburgerMenuItem>


        </HamburgerMenu:HamburgerMenu>

    </Grid>
</Page>
