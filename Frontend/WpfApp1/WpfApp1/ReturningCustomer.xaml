<Page x:Class="BfreshProject.ReturningCustomer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BfreshProject"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ReturningCustomer" Background="White" >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="130"/>
            <RowDefinition Height="1.5*"/>

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" ></ColumnDefinition>
            <ColumnDefinition Width="3*" ></ColumnDefinition>
            <ColumnDefinition Width="*" ></ColumnDefinition>
            <ColumnDefinition Width="1.5*" ></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Image  VerticalAlignment="Top" Grid.ColumnSpan="4" Source="\Images\Club Members.png"  >
            
        </Image>
        <TextBlock Text="Enter Your Phone Number Here:" Grid.Column="1" Grid.ColumnSpan="2"  Grid.Row="1" FontWeight="Bold" VerticalAlignment="Center" FontSize="48" ></TextBlock>
        <Image Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" Height="130" Source="\Images\arrow_transparent.png"   RenderTransformOrigin="0.5,0.5"  >
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-205.119"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Image.RenderTransform>


        </Image >
        <TextBox x:Name="txtCustNumber" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3" Height="110" Width="700" HorizontalAlignment="Left" Margin="10" MaxLength="10" FontSize="24"  ></TextBox>
        <Button Grid.Row="3" Width="200" HorizontalAlignment="Left" Grid.Column="2" Grid.ColumnSpan="2" Margin="10"  Content="Let's Go!" FontSize="20" FontWeight="DemiBold" Background="#87CEFA" Click="Button_Click" ></Button>
    </Grid>
</Page>
