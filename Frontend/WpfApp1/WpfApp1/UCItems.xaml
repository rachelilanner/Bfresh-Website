<UserControl x:Class="WpfApp1.UCItems"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp1" xmlns:wpfapp2="clr-namespace:WpfApp2"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" BorderBrush="Black" BorderThickness="3" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            
        
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" ></ColumnDefinition>
            <ColumnDefinition Width="2*" ></ColumnDefinition>
            <ColumnDefinition Width="2*" ></ColumnDefinition>
            <ColumnDefinition Width="2*" ></ColumnDefinition>
            <ColumnDefinition Width="1.2*" ></ColumnDefinition>
          
            
            <ColumnDefinition Width="3*" ></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <!--Source="{Binding Pic}"-->
        <Image x:Name="imgPic"  Grid.Row="0"  Grid.ColumnSpan="3" Grid.RowSpan="3" Grid.Column="3"  Height="200" Width="220"     />
        <Button x:Name="btnCart" Grid.Row="3" Grid.RowSpan="2" Grid.Column="5" HorizontalAlignment="Center" Height="60" Width="60" VerticalAlignment="Top" Click="Button_Click"  >
            <Button.Background>
                <ImageBrush ImageSource="\Images\sh.jpg"/>
            </Button.Background>

        </Button>
        <TextBox BorderThickness="0" Background="Transparent"  Grid.Row="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" Grid.RowSpan="2" Grid.ColumnSpan="3" VerticalAlignment="Bottom" Grid.Column="0" TextWrapping="Wrap" Text="{Binding Ingredients }" Height="160" Width="200"  FontSize="15"  FontFamily="Segoe UI Black"   />

        <TextBox BorderThickness="0" Background="Transparent" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"  Grid.ColumnSpan="3" TextWrapping="Wrap" Text="{Binding ItemName }" Height="60" Width="210"  FontSize="30" FontWeight="Bold"  FontFamily="Segoe UI Black"   />

        <wpfapp2:UCNumericUD x:Name="ucNum" Grid.ColumnSpan="2"  Width="90" Grid.Column="3" Height="30"  VerticalAlignment="Top"  Grid.Row="3"   >
           
        </wpfapp2:UCNumericUD>
        <RadioButton x:Name="radiobtnSmall" Content="{Binding Id.CategoryId.PriceSmall}" Grid.Column="0" Grid.Row="3"  Height="45" FontWeight="Bold" FontSize="20" HorizontalAlignment="Right"  VerticalAlignment="Center"  Checked="RadioButton_Checked" ></RadioButton>
        <RadioButton  x:Name="radiobtnMedium" Content="{Binding Id.CategoryId.PriceMedium}" Grid.Column="1" Grid.Row="3" VerticalAlignment="Center" FontSize="20" Height="45" HorizontalAlignment="Center"  FontWeight="Bold" Checked="radiobtnMedium_Checked" ></RadioButton>
        <RadioButton  x:Name="radiobtnLarge" Content="{Binding Id.CategoryId.PriceLarge}" Grid.Column="2" Grid.Row="3" VerticalAlignment="Center" FontSize="20" Height="45" HorizontalAlignment="Left"   FontWeight="Bold" Checked="radiobtnLarge_Checked" ></RadioButton>
       
        

    </Grid>
</UserControl>
