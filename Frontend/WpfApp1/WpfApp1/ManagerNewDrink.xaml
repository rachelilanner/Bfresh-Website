<Page x:Class="WpfApp1.ManagerNewDrink"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ManagerNewDrink">
    <Page.Background>
        <ImageBrush  Stretch="UniformToFill" ImageSource="\Images\Logo2.png"/>
    </Page.Background>



    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" ></ColumnDefinition>
            <ColumnDefinition Width="2*" ></ColumnDefinition>
            <ColumnDefinition Width="2*" ></ColumnDefinition>
            <ColumnDefinition Width="*" ></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="2" Text="Enter New Drink Information:" FontSize="24" FontWeight="Bold" TextDecorations="Underline" ></TextBlock>
        <TextBox x:Name="txtname" Grid.Column="2" BorderThickness="2" BorderBrush="Black" Margin="10" Grid.Row="1" Text="{Binding ItemName}" ></TextBox>
        <ComboBox Grid.Column="2" BorderThickness="2" BorderBrush="Black" x:Name="cmb"  Margin="10" Grid.Row="2" SelectedItem="{Binding CategoryId}" DisplayMemberPath="CategoryName"   ></ComboBox>

        <Image x:Name="imgPic"   Grid.Column="2" Margin="10" Grid.Row="3" Width="140" Height="110" HorizontalAlignment="Left" ></Image>
        <Button x:Name="btnPic" Content="..."  BorderThickness="2" BorderBrush="Black" Grid.Column="2"  Grid.Row="4" Width="80" HorizontalAlignment="Right" Margin="5"  Click="btnPic_Click" ></Button>
        <TextBox Grid.Column="2" x:Name="txtingredients" TextWrapping="Wrap" BorderThickness="2" BorderBrush="Black" Grid.Row="5" Margin="10" Text="{Binding Ingredients}" ></TextBox>
       
        <TextBlock Text="Item Name:" Grid.Column="1" Foreground="Black" Grid.Row="1"  FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Print"></TextBlock>
        <TextBlock Text="Category:" Grid.Column="1"  Grid.Row="2" Foreground="Black" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"  FontFamily="Segoe Print" ></TextBlock>
        <TextBlock Text="Pic:" Grid.Column="1"  Grid.Row="4" Foreground="Black" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Print"  ></TextBlock>
        <TextBlock Text="Ingredients:" Grid.Column="1"  Grid.Row="5" Foreground="Black" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Print"  ></TextBlock>
       
       
        <Button x:Name="btnOK" Grid.Column="0" Grid.ColumnSpan="2" Margin="250,15,250,15" Content="OK"  Grid.Row="6"  Foreground="#FF01010D" Background="#FFC6C6C6" Click="btnOK_Click"  />

    </Grid>
</Page>
