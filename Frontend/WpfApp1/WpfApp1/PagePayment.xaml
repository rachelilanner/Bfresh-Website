<Page x:Class="WpfApp1.PagePayment"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PagePayment" Background="White" >

  
    <Grid Margin="60">
        <Grid.RowDefinitions>
            <RowDefinition Height="1.4*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
           
            
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
       
            <Border Width="60" Height="60" Grid.Column="3" HorizontalAlignment="Right"  Background="SkyBlue" BorderBrush="DarkBlue" BorderThickness="2"  VerticalAlignment="Top" Margin="6" CornerRadius="105"  >
                <TextBlock x:Name="txtCusName" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="24" FontWeight="Bold">

                </TextBlock>
            </Border>
       

       
        <TextBlock Text="Payment Info" Grid.ColumnSpan="2" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Padding="5" Background="Gray" Foreground="White"/>

        
        <TextBlock Text="Credit Card Number" Grid.Row="1" HorizontalAlignment="Center"  VerticalAlignment="Center" FontFamily="Cooper Black" TextDecorations="Underline"/>
        <TextBox Grid.Row="1" x:Name="txtCCnum" MaxLength="16" Margin="3" Grid.Column="1" Height="30" />

        
        <TextBlock Text="Expiration Date" x:Name="cmbMonth" HorizontalAlignment="Center" Grid.Row="2" FontFamily="Cooper Black" TextDecorations="Underline" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
            <ComboBox x:Name="cmbmonth" Margin="3" Width="80" Height="30" >
              
            </ComboBox>
            <TextBlock Text="/" VerticalAlignment="Center" FontSize="20" Margin="10"  ></TextBlock>
            <ComboBox x:Name="cmbyear" Width="80" Height="30"  Margin="10">
               
            </ComboBox>
        </StackPanel>

      
        <TextBlock Text="Sum" FontFamily="Cooper Black" TextDecorations="Underline" HorizontalAlignment="Center"  Grid.Row="3" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" BorderThickness="0" x:Name="txtSum" HorizontalAlignment="Left" Width="60" Margin="3" FontSize="20" Grid.Column="1" Height="30" IsReadOnly="True"/>
        <TextBox Grid.Row="3" BorderThickness="0"  HorizontalAlignment="Center" Width="40" Margin="3" FontSize="20" Text="NIS" Grid.Column="1" Height="30" IsReadOnly="True" FontWeight="Bold"/>

       

        <!-- CVV -->
        <TextBlock FontFamily="Cooper Black" TextDecorations="Underline" HorizontalAlignment="Center" Text="CVV" Grid.Row="4" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
            <TextBox x:Name="txtCVV"  Width="60" Margin="3" MaxLength="4" Height="30"/>
            
        </StackPanel>

        <Button Grid.RowSpan="2" Grid.Column="3" Grid.ColumnSpan="2" Width="120" Grid.Row="4"  Height="100" Background="ForestGreen" Content="Place Order" x:Name="btnSendOrder" Click="btnSendOrder_Click_1"
  HorizontalAlignment="Right" VerticalAlignment="Bottom"
  BorderBrush="White" BorderThickness="2" FontSize="16">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              >
                        <Grid>
                            <TextBlock Text="{TemplateBinding Content}" 
                         HorizontalAlignment="Center" Margin="15"  VerticalAlignment="Top" 
                         Foreground="White" FontWeight="Bold" FontSize="16"/>
                            <Image Source="\Images\arrow_transparent - 3.png" Width="60" HorizontalAlignment="Center" Margin="10" VerticalAlignment="Bottom" ></Image>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>


    </Grid>

</Page>
