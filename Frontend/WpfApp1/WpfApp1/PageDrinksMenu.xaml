<Page x:Class="WpfApp1.PageDrinksMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageDrinksMenu" Background="White" >


    <Grid Margin="20" Background="#FF23A2D3" >
      

        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*" ></RowDefinition>
            <RowDefinition Height="8*" ></RowDefinition>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"   HorizontalAlignment="Center"   >
            <Image  Source="\Images\Our Menu.jpg"  />
         </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="15"  >
            <Border Width="55" Height="55" HorizontalAlignment="Right"  Background="SkyBlue" BorderBrush="DarkBlue" BorderThickness="2"  VerticalAlignment="Top" Margin="6" CornerRadius="105"  >
                <TextBlock x:Name="txtCusName" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="24" FontWeight="Bold">

                </TextBlock>
            </Border>
        </StackPanel>
        <Grid x:Name="grd" Grid.Row="1" Grid.Column="1"   >
            
            <Grid.ColumnDefinitions>
               
                <ColumnDefinition Width="2*" ></ColumnDefinition>
                <ColumnDefinition Width="2*" ></ColumnDefinition>
                <ColumnDefinition Width="2*" ></ColumnDefinition>
            </Grid.ColumnDefinitions>
       
        <ScrollViewer  Grid.Row="1"  Grid.Column="0"  Grid.RowSpan="2" Grid.ColumnSpan="3" >
            <WrapPanel Grid.Row="1" Grid.ColumnSpan="2"  x:Name="wrp"></WrapPanel>
        </ScrollViewer>

        <Button  Grid.Row="1" Grid.Column="2" x:Name="btnToCart" FontSize="18" VerticalContentAlignment="Top" Content="View Cart" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="10" Width="100" Height="65"  FontWeight="Bold" Click="btnToCart_Click" >
            <Button.Background>
                <ImageBrush ImageSource="\Images\sh.jpg"/>
            </Button.Background>
        </Button>
        
        </Grid>
    </Grid>
</Page>
