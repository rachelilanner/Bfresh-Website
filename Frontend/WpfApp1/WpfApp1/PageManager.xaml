<Page x:Class="WpfApp1.PageManager"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:HamburgerMenu="clr-namespace:HamburgerMenu;assembly=HamburgerMenu"
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageManager" >
    <Page.Background>
        <ImageBrush ImageSource="Images\Logo2.png" Stretch="UniformToFill"/>
    </Page.Background>









    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="*"/>


        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            <ColumnDefinition Width="*" ></ColumnDefinition>
            <ColumnDefinition Width="*" ></ColumnDefinition>
            <ColumnDefinition Width="*" ></ColumnDefinition>
            <ColumnDefinition Width="2*" ></ColumnDefinition>
        </Grid.ColumnDefinitions>
      


        <TextBlock Text="WELCOME MANAGER" Grid.Column="0" Grid.ColumnSpan="5"  VerticalAlignment="Top" Margin="50" HorizontalAlignment="Center" Grid.Row="0" Foreground="black" FontSize="42" FontWeight="Bold" FontFamily="Georgia" />
        <TextBlock Grid.Column="0" Grid.ColumnSpan="5"  VerticalAlignment="Center" Grid.Row="0" Text="What would you like to View or Edit today?" Foreground="black" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="100" FontFamily="MV Boli"/>
        <Image Grid.Row="0" Grid.Column="4" Grid.RowSpan="2" Height="170" Source="\Images\arrow_transparent.png" HorizontalAlignment="Left" Margin="60" RenderTransformOrigin="0.5,0.5" Cursor="Hand"  >
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-205.119"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Image.RenderTransform>


        </Image >



        <Button Width="180" Grid.Column="1" Grid.Row="1" Height="180" Background="#FF6D4C41" Click="btnViewDrinks_Click" Content="Drink" x:Name="btnviewDrinks"  Padding="10" Cursor="Hand">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="DodgerBlue"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="105" 
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="\Images\cup_only.png" Width="40" Height="40" Margin="5"/>
                                        <TextBlock TextWrapping="Wrap" Text="Drinks" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>


       
                         <Button Width="180"  Height="180" Background="#FF6D4C41"  x:Name="btnUpdateCategory"  Click="btnUpdateCategory_Click" Grid.Row="1" Grid.Column="2"   Padding="10" Cursor="Hand">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="DodgerBlue"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                CornerRadius="105" 
                                Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="\Images\yogurt-removebg-preview.png" Width="40" Height="40" Margin="5"/>
                                        <TextBlock TextWrapping="Wrap" Text="Category" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>


        <Button Width="180"  Height="180" Background="#FF6D4C41"  x:Name="btnUpdateToppings" Click="btnUpdateToppings_Click"   Grid.Row="1" Grid.Column="3"   Padding="10" Cursor="Hand">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="DodgerBlue"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                CornerRadius="105" 
                                Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="\Images\toppings.png" Width="40" Height="40" Margin="5"/>
                                        <TextBlock TextWrapping="Wrap" Text="Toppings" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>



        <StackPanel Grid.Column="0" Grid.ColumnSpan="5" Grid.Row="3" Background="#FF23A2D3" ></StackPanel>
    </Grid>

</Page>
    
    

