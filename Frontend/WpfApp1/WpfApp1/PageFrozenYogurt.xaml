<Page x:Class="WpfApp1.PageFrozenYogurt"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:WpfApp1" xmlns:wpfapp2="clr-namespace:WpfApp2"
     
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageFrozenYogurt" Background="White" >

    <Grid  >
       

        <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" ></ColumnDefinition>
            <ColumnDefinition Width="*" ></ColumnDefinition>
            <ColumnDefinition Width="*" ></ColumnDefinition>
            <ColumnDefinition Width="3*" ></ColumnDefinition>
            <ColumnDefinition Width="5*" ></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <TextBlock FontSize="60"  x:Name="txtFrozen" VerticalAlignment="Center"  Grid.Column="2" Grid.ColumnSpan="3"  FontFamily="Arial Black" Foreground="#FF23A2D3"  />
        <TextBlock FontSize="30" Grid.Row="1"  Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="4" Margin="50" Text="Choose Size Below:" TextWrapping="Wrap" FontFamily="Segoe UI Black" ></TextBlock>
        <Image Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" Height="150" Source="\Images\arrow_transparent.png" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="60" RenderTransformOrigin="0.5,0.5" Cursor="Hand"  >
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-205.119"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Image.RenderTransform>
           

        </Image >
        <RadioButton x:Name="radiobtnSmall" Content="{Binding Id.CategoryId.PriceSmall}" Grid.Column="1" Grid.Row="2" FontSize="35"  Height="45" FontWeight="Bold"  HorizontalAlignment="Left"  VerticalAlignment="Center" Checked="radiobtnSmall_Checked"  ></RadioButton>
        <RadioButton x:Name="radiobtnMedium" Content="{Binding Id.CategoryId.PriceMedium}" Grid.Column="2" Grid.Row="2" FontSize="35" VerticalAlignment="Center" Height="45" HorizontalAlignment="Left"  FontWeight="Bold" Checked="radiobtnMedium_Checked"  ></RadioButton>
        <RadioButton x:Name="radiobtnLarge" Content="{Binding Id.CategoryId.PriceLarge}"   Grid.Column="3" Grid.Row="2" FontSize="35" VerticalAlignment="Center" Height="45" HorizontalAlignment="Left"   FontWeight="Bold" Checked="radiobtnLarge_Checked" ></RadioButton>
        <Image Grid.Column="4"  Grid.RowSpan="2" Grid.ColumnSpan="2" Width="300" Grid.Row="1" Height="230" x:Name="img2" ></Image>
        <Button x:Name="btnToppingWindow" BorderThickness="1" Click="btnToppingWindow_Click" Grid.Column="3" Grid.Row="2" VerticalAlignment="Bottom" Width="160" Height="100" ToolTip="Toppings" Cursor="Hand"  Content="To Toppings" HorizontalContentAlignment="Center" FontSize="20" VerticalContentAlignment="Top" FontWeight="Bold" HorizontalAlignment="Right" >
            <Button.Background>
                <ImageBrush ImageSource="\Images\arrow_transparent - 3.png" Stretch="Fill" AlignmentX="Center" AlignmentY="Bottom"/>
            </Button.Background>
        </Button>
        <wpfapp2:UCNumericUD x:Name="ucNum"  Grid.Column="4"  Width="110" Height="35"  VerticalAlignment="Top"  Grid.Row="3"   >
           
            
        </wpfapp2:UCNumericUD>
        <Button x:Name="btnToCart" FontSize="15" VerticalContentAlignment="Top" Content="Add To Cart" Grid.Row="3" Grid.Column="4" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="10" Width="100" Height="75"  FontWeight="Bold" Click="btnAddToCart_Click" >
            <Button.Background>
                <ImageBrush ImageSource="\Images\sh.jpg"/>
            </Button.Background>
        </Button>
        <Border Width="60" Grid.Column="4" Height="60" HorizontalAlignment="Right"  Background="SkyBlue" BorderBrush="DarkBlue" BorderThickness="2"  VerticalAlignment="Top" Margin="10" CornerRadius="105"  >
            <TextBlock x:Name="txtCusName" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="24" FontWeight="Bold">

            </TextBlock>
        </Border>

    </Grid>
    
</Page>
