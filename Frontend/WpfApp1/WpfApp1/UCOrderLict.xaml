<UserControl x:Class="WpfApp1.UCOrderLict"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp1" xmlns:wpfapp2="clr-namespace:WpfApp2"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="white" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>


        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" ></ColumnDefinition>
            <ColumnDefinition Width="*" ></ColumnDefinition>
            <ColumnDefinition Width="*" ></ColumnDefinition>
            <ColumnDefinition Width="*" ></ColumnDefinition>
            <ColumnDefinition Width="3*" ></ColumnDefinition>
        </Grid.ColumnDefinitions>

       
        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="ExtraBold" HorizontalAlignment="Center" Grid.Row="4" Text="Note:" ></TextBlock>
        <TextBox   Grid.Row="4" x:Name="txtNote" Grid.RowSpan="2" Grid.ColumnSpan="4"  Grid.Column="0" TextWrapping="Wrap" Text="{Binding Note}"  Height="130" Width="200"  FontSize="12"     />
        <TextBlock VerticalAlignment="Center" Width="45" FontSize="15" FontWeight="ExtraBold" HorizontalAlignment="Center" Grid.Row="3" Text="Price: (Per Unit)" TextWrapping="Wrap" ></TextBlock>
        <TextBox x:Name="txtSsize"  Grid.Row="3" BorderThickness="0"     Grid.Column="1" TextWrapping="Wrap" Text="{Binding Ssize}" Height="60"  FontSize="20"  FontFamily="Segoe UI Black"   />
        <TextBlock Text="NIS" Grid.Row="3" FontSize="15" Height="40" FontWeight="Bold" Grid.Column="1" HorizontalAlignment="Right" ></TextBlock>
        <TextBlock  Grid.Row="0" FontSize="15" FontWeight="ExtraBold" Text="Name:" HorizontalAlignment="Center" VerticalAlignment="Bottom"  ></TextBlock>
        <TextBox   Grid.Row="0" BorderThickness="0" VerticalAlignment="Bottom" Grid.RowSpan="2" Grid.Column="1"  Grid.ColumnSpan="4" Margin="30" TextWrapping="Wrap" Text="{Binding ItemId.ItemName}" Height="60"   FontSize="15" FontWeight="Bold"  FontFamily="Segoe UI Black"   />
        <Image x:Name="img"  Grid.Row="1" Grid.RowSpan="3" Grid.Column="4"  Height="200" Width="250"  />
        <TextBlock x:Name="txtToppings" Visibility="Hidden" Grid.Row="4" Grid.Column="4" Text="Toppings" VerticalAlignment="Center"  HorizontalAlignment="Left" Height="60" FontSize="15" FontWeight="ExtraBold" ></TextBlock>
       
        <StackPanel Grid.ColumnSpan="2"   Orientation="Horizontal" Height="40" VerticalAlignment="Top"  Grid.Column="1" Grid.Row="2"  >
        <Button x:Name="btnPlus" FontWeight="Bold" Width="35" Height="40" Click="btnPlus_Click" Content="+"  VerticalAlignment="Center" HorizontalAlignment="Left" ></Button>
        <TextBlock x:Name="txtprice"  TextAlignment="Center" FontWeight="Bold" Width="40" Grid.Column="1" Grid.Row="2"  FontSize="20"  ></TextBlock>
        <Button x:Name="btnMinus"  FontWeight="Bold" Height="40" Width="35" Click="btnMinus_Click" Content="-"  VerticalAlignment="Center" HorizontalAlignment="Right" ></Button>
        </StackPanel>
        <TextBlock  Grid.Row="2"  FontSize="15" FontWeight="ExtraBold" Text="Quantity:" HorizontalAlignment="Center" VerticalAlignment="Top" ></TextBlock>
        <StackPanel Background="White" x:Name="stkTop" Grid.Column="4" Grid.Row="4" Grid.RowSpan="2"></StackPanel>
        <Button x:Name="btnDelete" Grid.Row="5"   Grid.Column="6" Margin="10" HorizontalAlignment="Right" Height="40" Width="40" VerticalAlignment="Bottom" Click="btnDelete_Click"  >
            <Button.Background>
                <ImageBrush ImageSource="\Images\garbage .png"/>
  </Button.Background>

        </Button>

    </Grid>
</UserControl>
