<Page x:Class="WpfApp1.Cart"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Cart" Background="white"  >

    <Grid >
        <Grid.RowDefinitions>

            <RowDefinition Height="1.2*"/>
            <RowDefinition Height="9*"/>

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="8*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="6*"></ColumnDefinition>
           
            <ColumnDefinition Width="2.1*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <TextBlock Text="MY CART"  TextAlignment="Center" FontWeight="Bold" Grid.ColumnSpan="4"  FontSize="40" Foreground="White" Background="#FF23A2D3" FontFamily="MV Boli" />
      
        <ScrollViewer  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Grid.RowSpan="3" >
            <WrapPanel Grid.Row="1" x:Name="wrp1"></WrapPanel>

        </ScrollViewer>

        <TextBlock Text="Sum:" TextAlignment="Center"  FontWeight="Bold" Grid.Column="0" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Right"  Margin="5" FontSize="20"   />
        <TextBlock Text="NIS" Margin="5" FontWeight="Bold" Grid.Column="2" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Left" FontSize="20"    />
        <TextBlock  x:Name="txtAmount" Grid.Column="1" Grid.Row="0" Margin="5" VerticalAlignment="Bottom" TextAlignment="Center"   Width="80" FontSize="20"  HorizontalAlignment="Right" ></TextBlock>
        <Button Width="140" Grid.ColumnSpan="2" Grid.Column="3" HorizontalAlignment="Right" Margin="10" VerticalAlignment="Bottom" Height="60" Background="#FF6D4C41" Grid.Row="2" x:Name="btnPayment" Click="btnPayment_Click"  Padding="10" Cursor="Hand">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="DodgerBlue"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                
                                 Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock VerticalAlignment="Center" Text="    Checkout" Foreground="White"/>
                                        <Image Source="\Images\arrow_transparent - 3.png" Width="30" Height="30" Margin="5"/>

                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

        <Border Width="55" Grid.RowSpan="2" Grid.ColumnSpan="2" Grid.Row="0" Grid.Column="3" Height="55" HorizontalAlignment="Right"  Background="SkyBlue" BorderBrush="DarkBlue" BorderThickness="2"  VerticalAlignment="Top" Margin="7" CornerRadius="105"  >
            <TextBlock x:Name="txtCusName" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="24" FontWeight="Bold">

            </TextBlock>
        </Border>
    </Grid>
</Page>
