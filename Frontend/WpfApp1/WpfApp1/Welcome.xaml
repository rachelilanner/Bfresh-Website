<Page x:Class="WpfApp1.Welcome"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:HamburgerMenu="clr-namespace:HamburgerMenu;assembly=HamburgerMenu"
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Welcome" Background="white" >

    <Grid>
        
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFFA8072" Offset="0.1"/>
              
                <GradientStop Color="#FFFFA500" Offset="0.5"/>
            
                <GradientStop Color="#FF1E90FF" Offset="1.0"/>
             
            </LinearGradientBrush>
        </Grid.Background>

 
        <Image Source="\Images\cup_only.png" Width="700" Height="700" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="50"/>

        
        <TextBlock Text="Welcome To B-Fresh!" 
                   Foreground="White" FontSize="48" FontWeight="Bold" 
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="40" FontFamily="Impact"/>

        <TextBlock  Text="Discover the most refreshing Drinks, Frozen Yogurts, and Bubble Drinks!" 
                   Foreground="White" FontSize="16" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="110" FontFamily="Segoe Print" />

      
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="30" VerticalAlignment="Bottom" >
            <Button x:Name="btnDrinks" Content="B-Drinks" Width="150" Click="btnDrinks_Click" Height="50" 
                    Background="Blue" Foreground="White" FontSize="16" Margin="10" Cursor="Hand"/>
            <Button x:Name="btnBubble" Content="B-Bubble" Width="150" Height="50" 
                    Background="DarkRed" Foreground="White" FontSize="16" Margin="10" Click="btnBubble_Click" Cursor="Hand"/>
            <Button x:Name="btnFrozen" Content="Frozen Yogurt" Width="150" Height="50" 
                    Background="Orange" Foreground="White" FontSize="16" Margin="10" Cursor="Hand" Click="btnFrozen_Click" />
        </StackPanel>


        <Border Width="60" Height="60" HorizontalAlignment="Right"  Background="SkyBlue" BorderBrush="DarkBlue" BorderThickness="2"  VerticalAlignment="Top" Margin="10" CornerRadius="105"  >
            <TextBlock x:Name="txtCusName" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="24" FontWeight="Bold">
                
            </TextBlock>
        </Border>

    </Grid>
</Page>
