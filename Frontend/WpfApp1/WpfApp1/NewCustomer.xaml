<Page x:Class="BfreshProject.NewCustomer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BfreshProject"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="NewCustomer" Background="white" >

    <Grid Margin="10" >
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            
            <RowDefinition Height="90"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="295"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>

        </Grid.ColumnDefinitions>



        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" FontSize="40" Text="Enter New Customer Information" VerticalAlignment="Center" FontWeight="Bold" HorizontalAlignment="Center" Margin="20"  TextAlignment="Center" FontFamily="Segoe Print" />

     
        <TextBlock Grid.Column="0" FontSize="35" Grid.Row="1" Text="First Name" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10" FontFamily="Segoe Print" FontWeight="Bold"/>
        <TextBox Grid.Column="1" FontSize="25" Grid.Row="1" x:Name="FirstNameTextBox" Text="{Binding FirstName}"  Margin="10" HorizontalAlignment="Stretch"/>

        
        <TextBlock Grid.Row="2"  FontSize="35" Text="Last Name" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10" FontFamily="Segoe Print" FontWeight="Bold"/>
        <TextBox  Grid.Column="1" FontSize="25" Grid.Row="2" x:Name="LastNameTextBox" Text="{Binding LastName}" Margin="10" HorizontalAlignment="Stretch"/>

        
        <TextBlock Grid.Row="3"  FontSize="35" Text="Phone Number" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Segoe Print" Margin="10" FontWeight="Bold"/>
        <TextBox Grid.Column="1" MaxLength="10" FontSize="25" Grid.Row="3" Name="PhoneTextBox" Text="{Binding PhoneNum}" Margin="10" HorizontalAlignment="Stretch"/>

       
        <TextBlock  Grid.Row="4"  FontSize="35" Text="Date of Birth" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Print" Margin="10" FontWeight="Bold"/>
        <DatePicker Grid.Column="1" FontSize="25" Grid.Row="4" Name="DobDatePicker" Width="200" HorizontalAlignment="Left" SelectedDate="{Binding Birthday}" Margin="10" />


        <TextBlock Grid.Row="5"  FontSize="35"  Text="Clubpoints" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Print" Margin="10" FontWeight="Bold"/>
        <TextBlock Grid.Column="1"  FontSize="25" Grid.Row="5" Name="ClubpointsTextBox" Text="{Binding Clubpoints}" Margin="10" HorizontalAlignment="Stretch"/>


        <Button Grid.Column="0"  Grid.ColumnSpan="2" Grid.Row="7" Content="Save Customer" HorizontalAlignment="Right" Width="100" Margin="0,0,10,10" Click="Button_Click" FontWeight="Bold" FontFamily="Corbel" FontSize="14"  >
            <Button.Background>
                <ImageBrush ImageSource="\Images\image_20250214_155052_515_37.jpg" Stretch="UniformToFill" TileMode="None"/>
            </Button.Background>
        </Button>
    </Grid>
</Page>
